# ==============================================================================
# SECURITY HARDENING: DISABLE SCRIPT EXECUTION IN UPLOADS DIRECTORY
# DPD PKS OGAN ILIR - PRODUCTION SECURITY LAYER
# ==============================================================================

# Disable directory browsing
Options -Indexes -ExecCGI

# Deny direct execution and access to script files
<FilesMatch "(?i)\.(php|phtml|php[0-9]|phps|pht|cgi|pl|py|sh|bash|exe|bat|cmd|suspected|ico\.php|jpg\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Disable PHP engine in this directory (Apache mod_php)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
