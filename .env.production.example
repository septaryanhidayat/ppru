APP_NAME="Pondok Pesantren Raudhatul Ulum Sakatiga"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ppru.ponpes.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nama_db_cpanel_ppru
DB_USERNAME=nama_user_cpanel_ppru
DB_PASSWORD=password_db_cpanel_anda

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.ppru.ponpes.id
MAIL_PORT=465
MAIL_USERNAME=admin@ppru.ponpes.id
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="admin@ppru.ponpes.id"
MAIL_FROM_NAME="${APP_NAME}"
