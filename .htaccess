# ----------------------------------------------------------------------
# CPANEL LITESPEED PHP 8.4 OVERRIDE (Bypass MultiPHP Manager Lock)
# ----------------------------------------------------------------------
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84___lsphp .php .php8 .phtml
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
  AddHandler application/x-httpd-alt-php84___lsphp .php .php8 .phtml
</IfModule>

<IfModule LiteSpeed>
  <FilesMatch "\.(php|phtml)$">
    SetHandler application/x-httpd-ea-php84___lsphp
  </FilesMatch>
</IfModule>

# Disable directory indexing
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Prevent access to hidden files and directories (like .env, .git)
    RewriteRule ^\.(.*)$ - [F,L]
    RewriteRule ^\.env.*$ - [F,L]

    # 2. Block direct access to internal Laravel directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|BACKUP|Desain)(\/.*)?$ - [F,L,NC]

    # 3. Block sensitive files and scripts in root
    RewriteRule ^(artisan|composer\.(json|lock)|package\.(json|lock)|phpunit\.xml|vite\.config\.js|boost\.json)$ - [F,L,NC]
    RewriteRule \.(sql|sqlite|sqlite3|log|key|md|bak|swp|xml)$ - [F,L,NC]

    # 4. Dual Domain Support: Normalize www to bare domain per host
    RewriteCond %{HTTP_HOST} ^www\.pksoganilir\.com$ [NC]
    RewriteRule ^(.*)$ https://pksoganilir.com/$1 [L,R=301]

    RewriteCond %{HTTP_HOST} ^www\.oganilir\.pks\.id$ [NC]
    RewriteRule ^(.*)$ https://oganilir.pks.id/$1 [L,R=301]

    RewriteCond %{HTTP_HOST} ^www\.ogan\.ilir\.pks\.id$ [NC]
    RewriteRule ^(.*)$ https://ogan.ilir.pks.id/$1 [L,R=301]

    # 4b. Legacy WordPress uploads redirect to clean Laravel /uploads/ (HTTP 301)
    RewriteRule ^wp-content/uploads/(.*)$ /uploads/$1 [R=301,L,NC]

    # 4c. Block legacy WordPress paths from scanner bots
    RewriteRule ^wp-content/(themes|plugins|cache|languages)(/.*)?$ - [F,L,NC]
    RewriteRule ^wp-includes(/.*)?$ - [F,L,NC]
    RewriteRule ^wp-admin(/.*)?$ - [F,L,NC]
    RewriteRule ^wp-login\.php$ - [F,L,NC]

    # 5. Enforce HTTPS (preserves whichever domain the user requested)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 6. Redirect all legitimate requests to public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L,QSA]
</IfModule>

# ----------------------------------------------------------------------
# CORS & STATIC ASSET HEADERS
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2|font\.css|css|js|webp|png|jpg|jpeg|svg|ico)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>


